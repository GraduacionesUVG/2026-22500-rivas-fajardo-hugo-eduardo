# variables del prototipo (prototipo/espacio.py y prototipo/app.py)
# en el Space se definen como variables del repositorio; en local se exportan antes de ejecutar
# sin credenciales: solo nombres y valores por omisión

# repositorio del Hub con imagenet_ajustado.pt y sintesis.pt, en formato usuario/repositorio
REPO_PESOS=

# nombre del punto de control dentro de ese repositorio, o ruta local
PUNTO_DE_CONTROL=imagenet_ajustado.pt
PUNTO_DE_CONTROL_SINTESIS=sintesis.pt

# tablas de las que se leen los cortes ajustados en validación
RESULTADOS=detector_oe1.csv
RESULTADOS_SINTESIS=sintesis.csv

# modelo de visión y lenguaje; vacío equivale a Qwen/Qwen2.5-VL-7B-Instruct
MODELO_VL=

# segundos de GPU por petición en ZeroGPU
DURACION_GPU=180

# notebooks de Colab: se lee de los secretos de Colab, no de este archivo
GITHUB_TOKEN=
